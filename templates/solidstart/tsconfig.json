{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["@solidjs/start/env"]
  },
  "include": ["app.config.ts", "src/**/*"]
}
