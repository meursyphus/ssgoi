{
  "name": "ssgoi",
  "homepage": "https://ssgoi.dev",
  "version": "2.0.0",
  "private": true,
  "description": "SSGOI is a powerful and easy-to-use page transition library for modern web frameworks (Angular, React, Svelte, Vue).",
  "scripts": {
    "build": "pnpm --filter ssgoi package",
    "core:watch": "pnpm --filter @ssgoi/core watch",
    "core:build": "pnpm --filter @ssgoi/core build",
    "angular:build": "pnpm --filter @ssgoi/angular build",
    "react:build": "pnpm --filter @ssgoi/react build",
    "svelte:build": "pnpm --filter @ssgoi/svelte build",
    "vue:build": "pnpm --filter @ssgoi/vue build",
    "solid:build": "pnpm --filter @ssgoi/solid build",
    "dev": "pnpm --filter dev dev",
    "docs": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "template:nextjs": "pnpm --filter ssgoi-nextjs-template dev",
    "template:nuxt": "pnpm --filter ssgoi-nuxt-template dev",
    "template:react-router": "pnpm --filter ssgoi-react-router-template dev",
    "template:sveltekit": "pnpm --filter ssgoi-sveltekit-template dev",
    "template:tanstack-router": "pnpm --filter ssgoi-tanstack-router-template dev",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "legacy-docs": "pnpm --filter legacy-docs dev",
    "legacy-docs:build": "pnpm --filter legacy-docs build",
    "version:bump": "node scripts/bump-version.mjs",
    "release:build": "pnpm -r --filter \"./packages/*\" run build",
    "release:publish": "pnpm -r --filter \"./packages/*\" publish --access public --no-git-checks",
    "release": "pnpm release:build && pnpm release:publish",
    "docs:cf-build": "pnpm release:build && pnpm --filter docs exec opennextjs-cloudflare build --skipWranglerConfigCheck",
    "prepare": "husky"
  },
  "author": "meursyphus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/meursyphus/ssgoi.git"
  },
  "bugs": {
    "url": "https://github.com/meursyphus/ssgoi/issues"
  },
  "keywords": [
    "angular",
    "react",
    "solid",
    "solidjs",
    "svelte",
    "sveltekit",
    "vue",
    "page-transition",
    "animation"
  ],
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "framer-motion": "^12.23.12",
    "next-mdx-remote-client": "^2.1.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "highlight.js": "^11.11.1",
    "highlightjs-svelte": "^1.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "baseline-browser-mapping": "2.10.27",
      "browserslist": "4.28.2",
      "caniuse-lite": "1.0.30001792",
      "update-browserslist-db": "1.2.3"
    }
  },
  "lint-staged": {
    "packages/core/**/*.{ts,tsx}": [
      "prettier --write --config packages/core/.prettierrc",
      "eslint --fix --config packages/core/eslint.config.js"
    ],
    "packages/angular/**/*.ts": [
      "prettier --write"
    ],
    "packages/react/**/*.{ts,tsx}": [
      "prettier --write --config packages/react/.prettierrc"
    ],
    "packages/svelte/**/*.{ts,svelte}": [
      "prettier --write --config packages/svelte/.prettierrc"
    ],
    "packages/vue/**/*.{ts,vue}": [
      "prettier --write --config packages/vue/.prettierrc",
      "eslint --fix --config packages/vue/eslint.config.js"
    ],
    "packages/solid/**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "apps/docs/**/*.{ts,tsx,js,jsx}": [
      "prettier --write --config apps/docs/.prettierrc"
    ],
    "apps/dev/**/*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ]
  }
}
