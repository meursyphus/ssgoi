{
  "$schema": "apps/docs/node_modules/wrangler/config-schema.json",
  "name": "ssgoi",
  "main": "apps/docs/.open-next/worker.js",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "apps/docs/.open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ssgoi"
    }
  ],
  "env": {
    "latest": {
      "name": "ssgoi-latest",
      "routes": [
        { "pattern": "latest.ssgoi.dev", "custom_domain": true }
      ],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "ssgoi-latest"
        }
      ]
    }
  }
}
