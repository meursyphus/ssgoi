{
  "name": "@ssgoi/qwik",
  "version": "7.1.0-beta.2",
  "description": "Qwik bindings for SSGOI - Native app-like page transitions for Qwik and Qwik City applications",
  "private": false,
  "sideEffects": false,
  "type": "module",
  "main": "./lib/index.qwik.mjs",
  "qwik": "./lib/index.qwik.mjs",
  "types": "./lib-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib-types/index.d.ts",
      "import": "./lib/index.qwik.mjs",
      "require": "./lib/index.qwik.cjs"
    },
    "./types": {
      "types": "./lib-types/types.d.ts",
      "import": "./lib/types.qwik.mjs",
      "require": "./lib/types.qwik.cjs"
    },
    "./view-transitions": {
      "types": "./lib-types/view-transitions.d.ts",
      "import": "./lib/view-transitions.qwik.mjs",
      "require": "./lib/view-transitions.qwik.cjs"
    }
  },
  "files": [
    "lib",
    "lib-types"
  ],
  "scripts": {
    "build": "pnpm run build.lib && pnpm run build.types",
    "build.lib": "vite build --mode lib",
    "build.types": "tsc --emitDeclarationOnly",
    "dev": "vite build --watch --mode lib",
    "watch": "vite build --watch --mode lib",
    "lint": "eslint \"src/**/*.ts*\"",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@ssgoi/core": "workspace:^"
  },
  "peerDependencies": {
    "@builder.io/qwik": "^1.20.0"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.0",
    "@eslint/js": "^9.30.1",
    "@types/node": "^22.10.6",
    "eslint": "^9.30.1",
    "eslint-plugin-qwik": "^1.20.0",
    "globals": "^16.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "keywords": [
    "qwik",
    "qwik-city",
    "page-transition",
    "page-transitions",
    "view-transitions",
    "view-transition-api-alternative",
    "animation",
    "ssgoi",
    "spring-physics",
    "cross-browser",
    "navigation-animation",
    "hero-transition",
    "shared-element-transition"
  ],
  "author": "MeurSyphus <tmdeoans@snu.ac.kr>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meursyphus/ssgoi.git",
    "directory": "packages/qwik"
  },
  "homepage": "https://ssgoi.dev",
  "bugs": {
    "url": "https://github.com/meursyphus/ssgoi/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
