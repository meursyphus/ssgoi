{
  "name": "@ssgoi/qwik",
  "version": "7.4.1",
  "description": "Native app-like page transitions for Qwik 2 and Qwik Router. Make a web app, PWA or WebView app feel native.",
  "private": false,
  "sideEffects": false,
  "type": "module",
  "main": "./lib/index.qwik.mjs",
  "qwik": "./lib/index.qwik.mjs",
  "types": "./lib-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib-types/index.d.ts",
      "import": "./lib/index.qwik.mjs"
    },
    "./types": {
      "types": "./lib-types/types.d.ts",
      "import": "./lib/types.qwik.mjs"
    },
    "./view-transitions": {
      "types": "./lib-types/view-transitions.d.ts",
      "import": "./lib/view-transitions.qwik.mjs"
    },
    "./qwik-city": {
      "types": "./lib-types/routers/qwik-city.d.ts",
      "import": "./lib/qwik-city.qwik.mjs"
    },
    "./qwik-router": {
      "types": "./lib-types/routers/qwik-router.d.ts",
      "import": "./lib/qwik-router.qwik.mjs"
    }
  },
  "files": [
    "lib",
    "lib-types"
  ],
  "scripts": {
    "build": "pnpm run build.lib && pnpm run build.types",
    "build.lib": "vite build --mode lib",
    "build.types": "tsc --emitDeclarationOnly",
    "dev": "vite build --watch --mode lib",
    "watch": "vite build --watch --mode lib",
    "lint": "eslint \"src/**/*.ts*\"",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@ssgoi/core": "workspace:^"
  },
  "peerDependencies": {
    "@qwik.dev/core": "^2.0.0-rc.2",
    "@qwik.dev/router": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^22.10.6",
    "eslint": "^9.30.1",
    "eslint-plugin-qwik": "^2.0.0-rc.2",
    "globals": "^16.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^8.3.4",
    "@qwik.dev/core": "^2.0.0-rc.2",
    "@qwik.dev/router": "^2.0.0-rc.2"
  },
  "keywords": [
    "qwik",
    "qwik-router",
    "page-transition",
    "page-transitions",
    "route-transition",
    "navigation-animation",
    "native-app",
    "app-like",
    "mobile-web",
    "webview",
    "pwa",
    "capacitor",
    "react-native-webview",
    "hybrid-app",
    "view-transitions",
    "view-transition-api-alternative",
    "shared-element-transition",
    "hero-transition",
    "spring-physics",
    "web-animations",
    "animation",
    "ssgoi"
  ],
  "author": "MeurSyphus <tmdeoans@snu.ac.kr>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meursyphus/ssgoi.git",
    "directory": "packages/qwik"
  },
  "homepage": "https://ssgoi.dev",
  "bugs": {
    "url": "https://github.com/meursyphus/ssgoi/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependenciesMeta": {
    "@qwik.dev/router": {
      "optional": true
    }
  }
}
