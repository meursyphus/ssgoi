{
  "name": "@ssgoi/react",
  "version": "7.1.0-beta.0",
  "description": "React bindings for SSGOI - Native app-like page transitions for React applications",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "plugin",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs",
      "default": "./dist/types.js"
    },
    "./view-transitions": {
      "types": "./dist/view-transitions.d.ts",
      "import": "./dist/view-transitions.js",
      "require": "./dist/view-transitions.cjs",
      "default": "./dist/view-transitions.js"
    },
    "./unplugin": {
      "types": "./dist/unplugin/index.d.ts",
      "import": "./dist/unplugin/index.js",
      "require": "./dist/unplugin/index.cjs",
      "default": "./dist/unplugin/index.js"
    },
    "./unplugin/webpack": {
      "types": "./dist/unplugin/webpack.d.ts",
      "import": "./dist/unplugin/webpack.js",
      "require": "./dist/unplugin/webpack.cjs",
      "default": "./dist/unplugin/webpack.js"
    },
    "./unplugin/vite": {
      "types": "./dist/unplugin/vite.d.ts",
      "import": "./dist/unplugin/vite.js",
      "require": "./dist/unplugin/vite.cjs",
      "default": "./dist/unplugin/vite.js"
    },
    "./unplugin/rollup": {
      "types": "./dist/unplugin/rollup.d.ts",
      "import": "./dist/unplugin/rollup.js",
      "require": "./dist/unplugin/rollup.cjs",
      "default": "./dist/unplugin/rollup.js"
    },
    "./unplugin/esbuild": {
      "types": "./dist/unplugin/esbuild.d.ts",
      "import": "./dist/unplugin/esbuild.js",
      "require": "./dist/unplugin/esbuild.cjs",
      "default": "./dist/unplugin/esbuild.js"
    },
    "./nextjs": {
      "types": "./dist/nextjs.d.ts",
      "import": "./dist/nextjs.js",
      "require": "./dist/nextjs.cjs",
      "default": "./dist/nextjs.js"
    },
    "./react-router": {
      "types": "./dist/react-router.d.ts",
      "import": "./dist/react-router.js",
      "require": "./dist/react-router.cjs",
      "default": "./dist/react-router.js"
    },
    "./tanstack-router": {
      "types": "./dist/tanstack-router.d.ts",
      "import": "./dist/tanstack-router.js",
      "require": "./dist/tanstack-router.cjs",
      "default": "./dist/tanstack-router.js"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -b && vite build",
    "watch": "vite build --watch",
    "lint": "eslint .",
    "preview": "vite preview",
    "package": "vite build",
    "prepare": "pnpm run build",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@ssgoi/core": "workspace:^",
    "unplugin": "^2.3.2",
    "@babel/core": "^7.26.10"
  },
  "devDependencies": {
    "@babel/traverse": "7.28.5",
    "@babel/types": "7.28.5",
    "@types/babel__core": "^7.20.5",
    "@eslint/js": "^9.30.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vite-plugin-dts": "^4.5.4",
    "next": "16.1.0",
    "react-router": "7.10.1",
    "@tanstack/react-router": "^1.93.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0"
  },
  "keywords": [
    "react",
    "page-transition",
    "page-transitions",
    "view-transitions",
    "view-transition-api-alternative",
    "animation",
    "ssgoi",
    "spring-physics",
    "nextjs",
    "next-js",
    "cross-browser",
    "navigation-animation",
    "hero-transition",
    "shared-element-transition",
    "route-transition",
    "drill-transition"
  ],
  "author": "MeurSyphus <tmdeoans@snu.ac.kr>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meursyphus/ssgoi.git",
    "directory": "packages/react"
  },
  "homepage": "https://ssgoi.dev",
  "bugs": {
    "url": "https://github.com/meursyphus/ssgoi/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "next": "*",
    "react-router": "*",
    "@tanstack/react-router": "*"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    }
  }
}
