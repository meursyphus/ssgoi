{
  "name": "@ssgoi/expo-router",
  "version": "7.1.2",
  "description": "SSGOI native transitions with the Expo Router route boundary (experimental)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./view-transitions": {
      "types": "./dist/view-transitions.d.ts",
      "default": "./dist/view-transitions.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:run": "jest --runInBand",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@ssgoi/react-native": "workspace:*",
    "standard-navigation": "0.0.9"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-native": ">=0.85.3 <0.86",
    "react-native-reanimated": "~4.3.1",
    "react-native-worklets": "0.8.3",
    "expo-router": "56.2.20"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "~5.8.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-worklets": "0.8.3",
    "expo": "56.0.21",
    "expo-router": "56.2.20",
    "jest": "^29.7.0",
    "jest-expo": "56.0.5",
    "@types/jest": "^29.5.14",
    "react-test-renderer": "19.2.3",
    "@testing-library/react-native": "^13.3.3",
    "react-dom": "19.2.3",
    "babel-preset-expo": "56.0.20",
    "@react-native/jest-preset": "0.85.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meursyphus/ssgoi.git",
    "directory": "packages/expo-router"
  },
  "publishConfig": {
    "access": "public"
  }
}
