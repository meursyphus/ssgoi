{
  "name": "@ssgoi/react-router",
  "version": "7.1.2",
  "description": "SSGOI React transitions with the react-router route boundary",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs",
      "default": "./dist/types.js"
    },
    "./view-transitions": {
      "types": "./dist/view-transitions.d.ts",
      "import": "./dist/view-transitions.js",
      "require": "./dist/view-transitions.cjs",
      "default": "./dist/view-transitions.js"
    },
    "./unplugin": {
      "types": "./dist/unplugin/index.d.ts",
      "import": "./dist/unplugin/index.js",
      "require": "./dist/unplugin/index.cjs",
      "default": "./dist/unplugin/index.js"
    },
    "./unplugin/webpack": {
      "types": "./dist/unplugin/webpack.d.ts",
      "import": "./dist/unplugin/webpack.js",
      "require": "./dist/unplugin/webpack.cjs",
      "default": "./dist/unplugin/webpack.js"
    },
    "./unplugin/vite": {
      "types": "./dist/unplugin/vite.d.ts",
      "import": "./dist/unplugin/vite.js",
      "require": "./dist/unplugin/vite.cjs",
      "default": "./dist/unplugin/vite.js"
    },
    "./unplugin/rollup": {
      "types": "./dist/unplugin/rollup.d.ts",
      "import": "./dist/unplugin/rollup.js",
      "require": "./dist/unplugin/rollup.cjs",
      "default": "./dist/unplugin/rollup.js"
    },
    "./unplugin/esbuild": {
      "types": "./dist/unplugin/esbuild.d.ts",
      "import": "./dist/unplugin/esbuild.js",
      "require": "./dist/unplugin/esbuild.cjs",
      "default": "./dist/unplugin/esbuild.js"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "watch": "vite build --watch",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ssgoi/react": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0",
    "react-router": "7.10.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meursyphus/ssgoi.git",
    "directory": "packages/react-router"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
