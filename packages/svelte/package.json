{
  "name": "@ssgoi/svelte",
  "version": "7.1.0-beta.2",
  "description": "Svelte bindings for SSGOI - Native app-like page transitions for Svelte and SvelteKit applications",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "scripts": {
    "watch": "svelte-package --watch",
    "build": "svelte-package",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "prepublishOnly": "pnpm run build",
    "test:run": "vitest run"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "dependencies": {
    "@ssgoi/core": "workspace:^"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "@sveltejs/kit": "*"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/js": "^9.18.0",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/kit": "^2.48.4",
    "@sveltejs/package": "^2.5.4",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "publint": "^0.3.2",
    "svelte": "^5.43.4",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.2.6",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "page-transition",
    "page-transitions",
    "view-transitions",
    "view-transition-api-alternative",
    "animation",
    "ssgoi",
    "spring-physics",
    "cross-browser",
    "navigation-animation",
    "hero-transition",
    "shared-element-transition"
  ],
  "author": "MeurSyphus <tmdeoans@snu.ac.kr>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meursyphus/ssgoi.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://ssgoi.dev",
  "bugs": {
    "url": "https://github.com/meursyphus/ssgoi/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "svelte": "./dist/types.js",
      "import": "./dist/types.js"
    },
    "./view-transitions": {
      "types": "./dist/view-transitions.d.ts",
      "svelte": "./dist/view-transitions.js",
      "import": "./dist/view-transitions.js"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit/index.d.ts",
      "svelte": "./dist/sveltekit/index.js",
      "import": "./dist/sveltekit/index.js"
    }
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    }
  }
}
