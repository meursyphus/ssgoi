{
  "name": "@ssgoi/alpine",
  "version": "7.4.1",
  "description": "Native app-like page transitions and spring animations for Alpine.js.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./view-transitions": {
      "types": "./dist/view-transitions.d.ts",
      "import": "./dist/view-transitions.js",
      "require": "./dist/view-transitions.cjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "watch": "vite build --watch",
    "test:run": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@ssgoi/core": "workspace:^",
    "@types/alpinejs": "^3.13.11"
  },
  "peerDependencies": {
    "alpinejs": "^3.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "alpinejs": "^3.14.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "alpine",
    "alpinejs",
    "page-transition",
    "animation",
    "ssgoi"
  ],
  "author": "MeurSyphus <tmdeoans@snu.ac.kr>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meursyphus/ssgoi.git",
    "directory": "packages/alpine"
  },
  "homepage": "https://ssgoi.dev",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
