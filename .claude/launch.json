{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "docs"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "docs-lan",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "docs",
        "exec",
        "next",
        "dev",
        "-H",
        "0.0.0.0",
        "-p",
        "3001"
      ],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "dev",
        "dev"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "motion-viewer",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "apps/dev/tools/motion-analyzer/run.sh",
        "serve",
        "apps/dev/tools/motion-analyzer/output/demo/report",
        "--port",
        "8765"
      ],
      "port": 8765,
      "autoPort": false
    },
    {
      "name": "docs-lan",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "docs",
        "dev",
        "--hostname",
        "0.0.0.0",
        "--port",
        "3000"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "core-tests",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ssgoi/core",
        "exec",
        "vite",
        "--host",
        "127.0.0.1",
        "--port",
        "4174",
        "--strictPort"
      ],
      "port": 4174,
      "autoPort": false
    },
    {
      "name": "docs-lan-3000",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "docs",
        "exec",
        "next",
        "dev",
        "-H",
        "0.0.0.0",
        "-p",
        "3000"
      ],
      "port": 3000,
      "autoPort": false
    }
  ]
}